{
  "manifest_version": 3,
  "name": "BreakTest Browser Recorder",
  "description": "Record a Firefox session as HAR with named BreakTest transactions.",
  "version": "1.1.1",
  "author": "Breaking IT",
  "homepage_url": "https://github.com/Breaking-IT/breaktest-browser-extension",
  "permissions": [
    "browserSettings",
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "har-export-store.js",
      "upload-store.js",
      "background.js"
    ]
  },
  "incognito": "spanning",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open BreakTest Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "sidebar_action": {
    "default_title": "BreakTest Recorder",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "open_at_install": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-recorder@breaktest.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "upload-capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
